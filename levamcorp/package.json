                    <div style="position: absolute; left: 8px; top: 0; width: 2px; height: 28px; background: #444;"></div>
                    <div style="position: absolute; left: 8px; bottom: 0; width: 20px; height: 2px; background: #444;"></div>
                    <div style="position: absolute; left: 13px; bottom: 8px; width: 12px; height: 2px; background: #2d7dd2;"></div>
                  </div>
                </div>
                <div>
                  <div style="font-size: 16px; font-weight: 500; letter-spacing: 0.18em; color: #ddd; text-transform: uppercase;">LEVAM</div>
